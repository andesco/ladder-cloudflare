{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ladderflare",
  "main": "index.js",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // "account_id": "", // optional: your unique Cloudflare account ID

  "browser": {
    "binding": "BROWSER"
  },

  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "workers_dev": true,
  "preview_urls": true,

  "routes": [
    {
      "pattern": "ladderflare.example.com",
      "custom_domain": true
    },
    {
      "pattern": "ladder.example.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./public"
  },

  "vars": {
    "VERSION": "0.0.0",
    "EXPOSE_RULESET": "true",
    "MANIFEST_URL": "https://bypass.example.com/manifest.json",
    "ALLOWED_DOMAINS_RULESET": "true"
  },

  "triggers": {
    "crons": ["0 12 * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "your-kv-namespace-id"
    }
  ]
}
