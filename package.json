{
  "name": "bypasser",
  "version": "0.0.1",
  "description": "Bypasser - BPC-powered HTTP proxy on Cloudflare Workers",
  "main": "index.js",
  "scripts": {
    "build:rules": "node scripts/build-rules.js",
    "build": "npm run build:rules",
    "deploy": "npm run build && wrangler deploy",
    "deploy:local": "npm run build && wrangler deploy --config wrangler.local.toml",
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local --config wrangler.local.toml"
  },
  "author": "Andrew Escobar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andesco/ladder/ladderflare"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "wrangler": "^4.36.0",
    "yaml": "^2.8.1"
  }
}
